# ---- Application ----
APP_ENVIRONMENT=local
APP_LOG_LEVEL=INFO

# ---- RAN policy thresholds ----
# These are operator/vendor policy, not 3GPP-mandated values.
# Tune them per network before drawing conclusions.
RAN_CONGESTION_PRB_PCT=80
RAN_SEVERE_CONGESTION_PRB_PCT=90
RAN_CONGESTION_EFFICIENCY_PCT=60
RAN_SEVERE_CONGESTION_EFFICIENCY_PCT=40
RAN_CAPACITY_WATCH_PRB_PCT=70
RAN_WEAK_RSRP_DBM=-110
RAN_GOOD_RSRP_DBM=-100
RAN_INTERFERENCE_SINR_DB=5
RAN_COVERAGE_SINR_DB=0
RAN_MIN_SPECTRAL_EFFICIENCY_BPS_HZ=1.0
RAN_MAX_DROP_CALL_RATE_PCT=1.0
RAN_CRITICAL_DROP_CALL_RATE_PCT=2.0

# ---- Agent layer ----
# Default: the deterministic offline stub. No key, no network, no model.
# Every response then reports "provider": "mock".
LLM_PROVIDER=mock

# To use a real model, set LLM_PROVIDER=openai and provide a key.
# Any OpenAI-compatible /chat/completions endpoint works, including a local runtime:
#   LLM_BASE_URL=http://localhost:11434/v1     (Ollama)
#   LLM_BASE_URL=http://localhost:1234/v1      (LM Studio)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Hard ceiling on agent loop iterations.
LLM_MAX_STEPS=4
